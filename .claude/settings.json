{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/changelog-before-pr.sh",
            "statusMessage": "Checking CHANGELOG.md for this PR"
          }
        ]
      }
    ]
  }
}
