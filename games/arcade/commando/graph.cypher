MERGE (n:KG {id: 'handler:commando_state.video_start'}) SET n:Handler SET n += {method: 'video_start', ownerClass: 'commando_state', sourceFile: 'src/mame/capcom/commando.cpp', sourceLine: 303, sourceColumn: 1, sourceEndLine: 309, sourceParameters: '', sourceBody: 'm_bg_tilemap = &machine().tilemap().create(*m_gfxdecode, tilemap_get_info_delegate(*this, FUNC(commando_state::get_bg_tile_info)), TILEMAP_SCAN_COLS, 16, 16, 32, 32);
	m_fg_tilemap = &machine().tilemap().create(*m_gfxdecode, tilemap_get_info_delegate(*this, FUNC(commando_state::get_fg_tile_info)), TILEMAP_SCAN_ROWS, 8, 8, 32, 32);

	m_fg_tilemap->set_transparent_pen(3);'};
MERGE (n:KG {id: 'handler:commando_state.get_bg_tile_info'}) SET n:Handler SET n += {method: 'get_bg_tile_info', ownerClass: 'commando_state', sourceFile: 'src/mame/capcom/commando.cpp', sourceLine: 283, sourceColumn: 1, sourceEndLine: 291, sourceParameters: 'tilemap_t &tilemap, tile_data &tileinfo, tilemap_memory_index tile_index', sourceBody: 'int const attr = m_colorram[0][tile_index];
	int const code = m_videoram[0][tile_index] + ((attr & 0xc0) << 2);
	int const color = attr & 0x0f;
	int const flags = TILE_FLIPYX((attr & 0x30) >> 4);

	tileinfo.set(1, code, color, flags);'};
MERGE (n:KG {id: 'handler:commando_state.get_fg_tile_info'}) SET n:Handler SET n += {method: 'get_fg_tile_info', ownerClass: 'commando_state', sourceFile: 'src/mame/capcom/commando.cpp', sourceLine: 293, sourceColumn: 1, sourceEndLine: 301, sourceParameters: 'tilemap_t &tilemap, tile_data &tileinfo, tilemap_memory_index tile_index', sourceBody: 'int const attr = m_colorram[1][tile_index];
