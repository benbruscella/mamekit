MERGE (n:KG {id: 'handler:commando_state.control_w'}) SET n:Handler SET n += {method: 'control_w', ownerClass: 'commando_state', sourceFile: 'src/mame/capcom/commando.cpp', sourceLine: 270, sourceColumn: 1, sourceEndLine: 281, sourceParameters: 'uint8_t data', sourceBody: '// bits 0 and 1 are coin counters
	machine().bookkeeping().coin_counter_w(0, data & 0x01);
	machine().bookkeeping().coin_counter_w(1, data & 0x02);

	// bit 4 resets the sound CPU
	m_audiocpu->set_input_line(INPUT_LINE_RESET, (data & 0x10) ? ASSERT_LINE : CLEAR_LINE);

	// bit 7 flips screen
	flip_screen_set(data & 0x80);'};
