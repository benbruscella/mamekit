MERGE (n:KG {id: 'handler:commando_state.screen_update'}) SET n:Handler SET n += {method: 'screen_update', ownerClass: 'commando_state', sourceFile: 'src/mame/capcom/commando.cpp', sourceLine: 340, sourceColumn: 1, sourceEndLine: 346, sourceParameters: 'screen_device &screen, bitmap_ind16 &bitmap, const rectangle &cliprect', sourceBody: 'm_bg_tilemap->draw(screen, bitmap, cliprect, 0, 0);
	draw_sprites(bitmap, cliprect);
	m_fg_tilemap->draw(screen, bitmap, cliprect, 0, 0);
	return 0;'};
MERGE (n:KG {id: 'handler:commando_state.draw_sprites'}) SET n:Handler SET n += {method: 'draw_sprites', ownerClass: 'commando_state', sourceFile: 'src/mame/capcom/commando.cpp', sourceLine: 311, sourceColumn: 1, sourceEndLine: 338, sourceParameters: 'bitmap_ind16 &bitmap, const rectangle &cliprect', sourceBody: 'uint8_t *spriteram = m_spriteram->buffer();

	for (int offs = m_spriteram->bytes() - 4; offs >= 0; offs -= 4)
	{
		// bit 1 of attr is not used
		int const attr = spriteram[offs + 1];
		int const bank = (attr & 0xc0) >> 6;
		int const code = spriteram[offs] + 256 * bank;
		int const color = (attr & 0x30) >> 4;
		int flipx = attr & 0x04;
		int flipy = attr & 0x08;
		int sx = spriteram[offs + 3] - ((attr & 0x01) << 8);
		int sy = spriteram[offs + 2];

		if (flip_screen())
		{
			sx = 240 - sx;
			sy = 240 - sy;
			flipx = !flipx;
			flipy = !flipy;
		}

		if (bank < 3)
			m_gfxdecode->gfx(2)->transpen(bitmap, cliprect, code, color, flipx, flipy, sx, sy, 15);
	}'};
