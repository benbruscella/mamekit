MERGE (n:KG {id: 'handler:qix_state.videoram_w'}) SET n:Handler SET n += {method: 'videoram_w', ownerClass: 'qix_state', sourceFile: 'src/mame/taito/qix_v.cpp', sourceLine: 87, sourceColumn: 1, sourceEndLine: 99, sourceParameters: 'offs_t offset, uint8_t data', sourceBody: '/* update the screen in case the game is writing "behind" the beam -
	   Zookeeper likes to do this */
//  m_screen->update_now();
	m_screen->update_partial(m_screen->vpos());

	/* add in the upper bit of the address latch */
	offset += (m_videoram_address[0] & 0x80) << 8;

	/* write the data */
	m_videoram[offset] = data;'};
