MERGE (n:KG {id: 'handler:qix_state.display_enable_changed'}) SET n:Handler SET n += {method: 'display_enable_changed', ownerClass: 'qix_state', sourceFile: 'src/mame/taito/qix_v.cpp', sourceLine: 36, sourceColumn: 1, sourceEndLine: 47, sourceParameters: 'int state', sourceBody: '/* on the rising edge, latch the scanline */
	if (state)
	{
		uint16_t const ma = m_crtc->get_ma();
		uint8_t const ra = m_crtc->get_ra();

		/* RA0-RA2 goes to D0-D2 and MA5-MA9 goes to D3-D7 */
		*m_scanline_latch = ((ma >> 2) & 0xf8) | (ra & 0x07);
	}'};
