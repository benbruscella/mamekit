MERGE (n:KG {id: 'handler:qix_state.palettebank_w'}) SET n:Handler SET n += {method: 'palettebank_w', ownerClass: 'qix_state', sourceFile: 'src/mame/taito/qix_v.cpp', sourceLine: 194, sourceColumn: 1, sourceEndLine: 206, sourceParameters: 'uint8_t data', sourceBody: '/* set the bank value */
	if (m_palette_bank != (data & 3))
	{
		//m_screen->update_now();
		m_screen->update_partial(m_screen->vpos());
		m_palette_bank = data & 3;
	}

	/* LEDs are in the upper 6 bits */
	m_leds = ~data & 0xfc;'};
