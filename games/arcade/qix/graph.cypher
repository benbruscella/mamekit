MERGE (n:KG {id: 'handler:qix_state.videoram_r'}) SET n:Handler SET n += {method: 'videoram_r', ownerClass: 'qix_state', sourceFile: 'src/mame/taito/qix_v.cpp', sourceLine: 79, sourceColumn: 1, sourceEndLine: 84, sourceParameters: 'offs_t offset', sourceBody: '/* add in the upper bit of the address latch */
