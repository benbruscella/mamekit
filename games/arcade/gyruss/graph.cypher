MERGE (n:KG {id: 'device:gyruss_state.gyruss/ay1/callback:ay1:0'}) SET n:Callback SET n += {signal: 'port_b_write_callback', operation: 'set', raw: 'ay1.port_b_write_callback().set(FUNC(gyruss_state::filter_w<0>))', ownerTag: 'ay1', sourceFile: 'src/mame/konami/gyruss.cpp', sourceLine: 753, sourceColumn: 2, sourceEndLine: 753, targetClass: 'gyruss_state', targetMethod: 'filter_w_0'};
MERGE (n:KG {id: 'handler:gyruss_state.filter_w_0'}) SET n:Handler SET n += {method: 'filter_w_0', ownerClass: 'gyruss_state', sourceFile: 'src/mame/konami/gyruss.cpp', sourceLine: 360, sourceColumn: 1, sourceEndLine: 370, sourceConstants: ['Which=0'], sourceParameters: 'uint8_t data', sourceBody: 'LOGFILTER("chip %d - %02x\\n", Which, data);
	for (int i = 0; i < 3; i++)
	{
		// low bit: 47000pF = 0.047uF
		// high bit: 220000pF = 0.22uF
		m_discrete->write(NODE(3 * Which + i + 21), data & 3);
		data >>= 2;
	}'};
