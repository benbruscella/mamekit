MERGE (n:KG {id: 'handler:gyruss_state.video_start'}) SET n:Handler SET n += {method: 'video_start', ownerClass: 'gyruss_state', sourceFile: 'src/mame/konami/gyruss.cpp', sourceLine: 263, sourceColumn: 1, sourceEndLine: 270, sourceParameters: '', sourceBody: 'm_tilemap = &machine().tilemap().create(*m_gfxdecode, tilemap_get_info_delegate(*this, FUNC(gyruss_state::get_tile_info)), TILEMAP_SCAN_ROWS, 8, 8, 32, 32);
	m_tilemap->set_transmask(0, 0x00, 0); // opaque
