    },
    {
      "id": "handler:gb_state.boot_r",
      "label": "Handler",
      "props": {
        "method": "boot_r",
        "ownerClass": "gb_state",
        "sourceFile": "src/mame/nintendo/gb.cpp",
        "sourceLine": 439,
        "sourceColumn": 1,
        "sourceEndLine": 451,
        "sourceParameters": "offs_t offset",
        "sourceBody": "if (m_bios_hack->read())\n\t{\n\t\t// patch out logo and checksum checks\n\t\t// useful to run some pirate carts until properly emulated, or to test homebrew\n\t\tif (offset == 0xe9 || offset == 0xea)\n\t\t\treturn 0x00;\n\t\tif (offset == 0xfa || offset == 0xfb)\n\t\t\treturn 0x00;\n\t}\n\treturn m_region_boot[offset];",
        "inputMembers": [
          "m_bios_hack=SKIP_CHECK"
        ]
      }
    },
