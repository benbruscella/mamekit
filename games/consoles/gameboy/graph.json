      "label": "Callback",
      "props": {
        "signal": "timer_cb",
        "operation": "set",
        "raw": "m_maincpu->timer_cb().set(FUNC(gb_state::gb_timer_callback))",
        "ownerTag": "maincpu",
        "sourceFile": "src/mame/nintendo/gb.cpp",
        "sourceLine": 1047,
        "sourceColumn": 2,
        "sourceEndLine": 1047,
        "targetClass": "gb_state",
        "targetMethod": "gb_timer_callback"
