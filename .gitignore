# Local asset tree: ROMs and artwork are copyrighted — never commit them.
# Both live under .data/, so one rule covers the lot (see .data/Makefile).
/.data/

# Former locations, kept so a stray copy of either can never be committed
/roms/
/_roms/
artwork/
*.zip

/node_modules/
/out/
/dist/

# Local generation cache: MAME-derived data memoized against the checkout's
# HEAD revision (see src/gen/driver-history.ts). Never committed.
/.cache/

# Desktop MAME writes these relative to its working directory when diagnostic
# runs use the default cfg_directory, snapshot_directory and nvram_directory.
# They are one machine's local session state, not project source: nvram/ was
# committed by accident in #52 and carried entries for games this repository
# does not even target.
/cfg/
/snap/
/nvram/

.DS_Store
.playwright-mcp/
.env
.files

# Playwright run artefacts: traces, failure screenshots and the HTML report.
# The reviewed baselines under e2e/snapshots/ ARE committed.
/test-results/
/playwright-report/
/e2e/test-results/
/blob-report/
/.playwright/

# scratch files from investigation sessions
*.tmp.*
.files/
dist.previous/
