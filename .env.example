# Machine-local settings for MAMEKIT. Copy this file to .env (git-ignored)
# and fill in the paths for this machine. A variable already set in the shell
# wins over .env, so CI and one-off runs keep working. Read by
# src/local-env.ts, which every entry point (generation, the spec runner,
# audit:facts, test:netlists, mkt) loads first.

# The MAME source checkout, at the release tag (the directory that holds
# makefile and src/mame). Unset, MAMEKIT looks for a sibling ../mame.
MAME_SRC=/path/to/mame

# The MAME binary of the same release as MAME_SRC. Used by audit:facts and
# every mkt command; a binary of another release is refused. Quote a path
# with spaces.
MAME_BIN="/path/to/mame0289/mame"

# Where ROM and sample sets are kept. Leave these unset for the default
# .data/roms and .data/samples directories.
# MAMEKIT_ROMS=/path/to/roms
# MAMEKIT_SAMPLES=/path/to/samples
